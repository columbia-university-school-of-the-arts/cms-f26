# TMDB access for ~/cms-lab/tmdb. Copy to .env and fill in; .env is never committed.
#
# Free account at https://www.themoviedb.org/signup, then
# Settings -> API -> request a key (personal / educational use).
# Use the long "API Read Access Token", not the short "API Key".
# Sent in the Authorization header, never in a URL.
TMDB_TOKEN=
